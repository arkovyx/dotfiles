#!/bin/bash
set -u
LAST=$(cat "$HOME/.cache/tzeuk/wallpicker/last_wallpaper" 2>/dev/null)
[ -n "$LAST" ] && [ -f "$LAST" ] || exit 0

if ! pgrep -x awww-daemon >/dev/null 2>&1; then
    awww-daemon >/dev/null 2>&1 &
    sleep 0.6
fi
if ! pgrep -x swww-daemon >/dev/null 2>&1; then
    swww-daemon >/dev/null 2>&1 &
    sleep 0.6
fi

awww img "$LAST" >/dev/null 2>&1 || swww img "$LAST" >/dev/null 2>&1 || true
[ -x "$HOME/.local/bin/tzk-theme" ] && "$HOME/.local/bin/tzk-theme" "$LAST"
hyprctl reload config-only >/dev/null 2>&1 || true
