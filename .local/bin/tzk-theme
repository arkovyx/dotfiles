#!/bin/bash
set -u
WALL="${1:-}"
[ -f "$WALL" ] || { echo "usage: tzk-theme <wallpaper>"; exit 1; }

WAL_CACHE="$HOME/.cache/wal"
mkdir -p "$WAL_CACHE"

# ── 1. pywal: extract 16 colors ──
if ! wal -i "$WALL" -n -q 2>/dev/null; then
    echo "wal failed for $WALL" >&2
    exit 1
fi

# ── 2. inject $wallpaper for hyprlock background ──
if [ -f "$WAL_CACHE/colors-hyprland.conf" ]; then
    sed -i '/^\$wallpaper/d' "$WAL_CACHE/colors-hyprland.conf"
    echo "\$wallpaper = $WALL" >> "$WAL_CACHE/colors-hyprland.conf"
fi

# ── 3. push ANSI sequences → live terminal reload ──
if [ -s "$WAL_CACHE/sequences" ]; then
    for pts in /dev/pts/[0-9]*; do
        [ -c "$pts" ] && cat "$WAL_CACHE/sequences" > "$pts" 2>/dev/null || true
    done
    pkill -USR1 -x kitty 2>/dev/null || true
fi

# ── 4. hyprland Lua config ──
if [ -f "$WAL_CACHE/colors.json" ]; then
    python3 - <<'PY' > "$WAL_CACHE/hyprland-colors.lua"
import json, os
d = json.load(open(os.path.expanduser("~/.cache/wal/colors.json")))
bg = d["special"]["background"].lstrip("#")
fg = d["special"]["foreground"].lstrip("#")
c1 = d["colors"]["color1"].lstrip("#")
c4 = d["colors"]["color4"].lstrip("#")
c5 = d["colors"]["color5"].lstrip("#")
c8 = d["colors"]["color8"].lstrip("#")
print("-- Generated by tzk-theme")
print("return {")
print(f'  primary         = "rgba({c1}ff)",')
print(f'  tertiary        = "rgba({c5}ff)",')
print(f'  secondary       = "rgba({c4}ff)",')
print(f'  container       = "rgba({c8}ff)",')
print(f'  surface         = "rgba({bg}ff)",')
print(f'  surface_lowest  = "rgba({bg}ff)",')
print(f'  surface_high    = "rgba({c8}ff)",')
print(f'  surface_highest = "rgba({c8}ff)",')
print(f'  on_surface      = "rgba({fg}ff)",')
print(f'  outline         = "rgba({c8}ff)",')
print(f'  outline_variant = "rgba({c8}ff)",')
print(f'  error           = "rgba({c1}ff)",')
print("}")
PY
fi

# ── 5. cava config (overwrite — theirs is only [color]) ──
if [ -s "$WAL_CACHE/cava" ]; then
    cp "$WAL_CACHE/cava" "$HOME/.config/cava/config"
fi

# ── 6. rmptui theme merge ──
[ -x "$HOME/.local/bin/tzk-rmptui" ] && bash "$HOME/.local/bin/tzk-rmptui" 2>/dev/null || true

# ── 7. reload running consumers ──
hyprctl reload config-only >/dev/null 2>&1 || true
pkill -USR2 -x cava 2>/dev/null || true

echo "tzk-theme: $(basename "$WALL") applied"
